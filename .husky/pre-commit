# lint-staged treats every line of git output as a path. A merge with thousands of
# renames makes `git diff` warn about diff.renameLimit, and that warning is then
# passed to `git add`. Raise the limit for this process only.
i=${GIT_CONFIG_COUNT:-0}
eval "export GIT_CONFIG_KEY_$i=diff.renameLimit"
eval "export GIT_CONFIG_VALUE_$i=10000"
export GIT_CONFIG_COUNT=$((i + 1))

# A lint-staged crash mid-merge would strand the resolved conflicts in its backup stash, so skip the stash.
# Without the stash lint-staged cannot restore hidden unstaged lines, so keep it when a file is partially staged.
git_dir=$(git rev-parse --git-dir)
if { [ -f "$git_dir/MERGE_HEAD" ] || [ -f "$git_dir/REBASE_HEAD" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; } &&
   [ -z "$({ git diff --name-only; git diff --cached --name-only; } | sort | uniq -d)" ]; then
  bun run precommit --no-stash
else
  bun run precommit
fi

# Run the formatter
# Note that this is stubbed in for now until we can gobally resolve some formatting issues such as what is described
# here: https://github.com/metabase/metabase/pull/35511#pullrequestreview-1721758128
# ATM, you can manually run ./bin/cljfmt_staged.sh if you want to format locally staged files and inspect after.
# ./bin/cljfmt_staged.sh

./hooks/pre-commit.nocommit
